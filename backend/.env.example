# --- Local development (copy to .env) ---
docs_generator_api_key=your_deepseek_api_key_here

# --- Production (Render etc.) — set in dashboard, not committed ---
# SECRET_KEY=long-random-string
# DEBUG=False
# ALLOWED_HOSTS=your-service.onrender.com
# DATABASE_URL=postgres://...
# FRONTEND_URL=https://your-app.vercel.app
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
# Vercel + Render: OAuth redirect must be the *backend* URL (Google sends the code here):
# GOOGLE_OAUTH_REDIRECT_URI=https://your-service.onrender.com/api/auth/google/callback

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Local: Authorized redirect URI http://localhost:5173/api/auth/google/callback (Vite proxy)
# Vercel+Render: use backend URL as in GOOGLE_OAUTH_REDIRECT_URI above
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional email (server-side send)
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
